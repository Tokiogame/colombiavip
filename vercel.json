{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/novedades", "destination": "/actualizaciones", "permanent": true },
    { "source": "/novedades/:slug", "destination": "/actualizaciones/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/actualizaciones/:slug", "destination": "/actualizaciones/index.html" }
  ]
}
